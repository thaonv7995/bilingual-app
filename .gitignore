# OS specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Databases (runtime SQLite databases)
*.db
*.db-journal
*.sqlite
*.sqlite3

# Local Environment & Secrets Configuration
config.js
.env
.env.*
!.env.example
!application/.env.example

# Python virtual environment and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.venv/
**/venv/
**/.venv/
application/backend/dist/
application/backend/*.egg-info/
application/backend/build/

# Node / JavaScript dependencies and logs
node_modules/
**/node_modules/
.expo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Playwright & Browser automation caches
.playwright-cli/
**/.playwright-cli/

# Xcode & iOS build outputs / user preferences
*.xcuserstate
project.xcworkspace/
xcuserdata/
**/xcuserdata/
DerivedData/
**/DerivedData/
build/
**/build/
application/mobile_ios/*.xcworkspace/

# Application Specific Dynamic Data (Agent work directory, inbox PDFs, etc.)
application/data/

# Dynamic Book Unpack Destination
# Ignore all dynamically extracted book subdirectories in books/
# but keep the folder structure by preserving .gitkeep
books/*
!books/.gitkeep

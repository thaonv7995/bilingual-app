# Frontend build-time config for v2 (Vite exposes VITE_* to the client).
# Copy to .env for local dev. Never put real secrets here — anything VITE_*
# is shipped to the browser. Provider API keys live in the BACKEND env
# (hybrid model): the server injects them into /api/chat and realtime.

# Optional: override the API base (defaults to same-origin, proxied in dev).
VITE_API_BASE=

# Optional default voca-bridge origin shown in Settings (token stays server-side).
VITE_VOCA_BRIDGE_ORIGIN=https://voca-bridge.thaonv.online

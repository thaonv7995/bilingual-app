# Optional — passed to books-cli serve (agent CLIs inherit this env).
# CURSOR_API_KEY=your_cursor_api_key
# OPENAI_API_KEY=...   # for Codex CLI

# Backend (FastAPI) env. On a server these go in the install-root .env
# (/opt/bilingual-app/.env) — see backend/docs/DEPLOYMENT.md.
# Voca API — https only: the host also answers plain http with no redirect, so an
# http:// origin would ship the key in cleartext. voca-bridge.thaonv.online is dead.
# VOCA_API_ORIGIN=https://voca.thaonv.online
# VOCA_BRIDGE_ORIGIN=...      # legacy alias, read only when VOCA_API_ORIGIN is unset
# VOCA_BRIDGE_TOKEN=voca_...  # server-default key (voca_ prefix required); users can
#                             # set their own in Settings, which wins over this
